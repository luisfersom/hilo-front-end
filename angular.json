{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "hilo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/hilo",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "assets/img",
                "output": "assets/img"
              },
              {
                "glob": "**/*",
                "input": "data",
                "output": "data"
              }
            ],
            "styles": ["assets/css/styles.css"],
            "baseHref": "./"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "hilo:build"
          }
        }
      }
    }
  }
}
